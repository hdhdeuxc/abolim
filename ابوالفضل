# ----------------------------
# فیلتر کلمات نامناسب (با استفاده از عبارات منظم)
# ----------------------------
# این الگوها سعی می‌کنن حالت‌های مختلف فحاشی رو پوشش بدن.
# شما می‌تونید الگوهای بیشتری اضافه کنید.
profanity_patterns = [
    r"کیر", r"کس", r"کص", r"جنده", r"ممه", r"کونی", r"لواط", r"تخمی",
    r"خر", # ممکنه به اشتباه فیلتر بشه، اگر زیاد هست حذفش کن
    r"عن", r"گوه", r"پدر سگ", r"مادر جنده",
    # اضافه کردن الگوهای بیشتر در صورت نیاز
]

# کامباین کردن الگوها در یک عبارت منظم بزرگتر
profanity_regex = re.compile("|".join(profanity_patterns), re.IGNORECASE)

@bot.on_message(filters.text) # فیلتر روی همه‌ی پیام‌های متنی اعمال میشه
async def profanity_filter_handler(app, message: Message):
    user_text = getattr(message, "text", "") or ""
    if user_text and profanity_regex.search(user_text):
        await message.reply("ارسال فحش و کلمات نامناسب ممنوع است! 🚫")
        try:
            # سعی در حذف پیام برای جلوگیری از دیده‌شدن
            await message.delete()
        except Exception as e:
            print(f"Error deleting message: {e}") # برای دیباگ
            pass # اگر حذف پیام ممکن نبود، خطایی رخ ندهد

